# Copy these values into Coolify's Environment Variables.
# Do NOT commit real passwords or secrets to Git.

COMPOSE_PROJECT_NAME=frappe-v16
VOLUME_PREFIX=frappe-prod

FRAPPE_BRANCH=version-16
FRAPPE_PATH=https://github.com/frappe/frappe
CUSTOM_IMAGE=frappe-custom
CUSTOM_TAG=v16
CACHE_BUST=

# Add every DNS hostname that should be provisioned, comma-separated.
SITES=erp.example.com,crm.example.com

# Every listed app is installed on every site.
# Add your custom app's Python module name after adding its repo to apps.json.
INSTALL_APPS=erpnext,hrms,crm

# Set strong, unique values in Coolify. Never use these examples as passwords.
DB_ROOT_PASSWORD=
ADMIN_PASSWORD=

GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m
